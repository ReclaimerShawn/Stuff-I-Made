xor eax, eax

originalcode:
//mov [ecx+08],eax
//xor eax,eax

exit:
jmp returnhere

"re5dx9.exe"+84C1EF:
jmp newmem
returnhere:

alloc(newmem2,2048)
label(returnhere2)
