      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
globalalloc(weapaddress, 4)

newmem:
mov eax, ecx
add eax, 0x8
mov [weapaddress], eax
