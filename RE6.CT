    <CheatEntry>
      <ID>15</ID>
      <Description>"Infinite HP"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [ecx+00000F12], 0xFFFF0384
jne enemy
jmp end
enemy:
sub [ecx+00000F10],ax
end:

originalcode:
//sub [ecx+00000F10],ax

exit:
jmp returnhere

"BH6.exe"+55DA45:
jmp newmem
nop 2
returnhere:

[DISABLE]
BH6.exe+55DA45:
sub [ecx+00000F10],ax
</AssemblerScript>
    </CheatEntry>
