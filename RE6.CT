<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>19</ID>
      <Description>"Infinite Ammo (And Item Finder)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
globalalloc(base, 4)

newmem:
push ebx
mov ebx, eax
imul ebx, 2
add ebx, 0xA
add ebx, ecx
mov [ecx+eax*2+0A], 0xFF
mov [base], ebx
pop ebx

originalcode:
//sub [ecx+eax*2+0A],dx

exit:
jmp returnhere

"BH6.exe"+97F707:
jmp newmem
returnhere:

BH6.exe+97F5D2:
mov eax, 0xFF

[DISABLE]
BH6.exe+97F707:
sub [ecx+eax*2+0A],dx

BH6.exe+97F5D2:
movsx eax,word ptr [ecx+eax*2+0A]
</AssemblerScript>
